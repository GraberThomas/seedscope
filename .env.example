# Copier vers .env, puis : chmod 600 .env
TZ=Europe/Paris

# Adresse de l'interface web de qBittorrent, vue depuis le conteneur.
QBT_URL=http://192.168.1.10:8080
QBT_USERNAME=admin
QBT_PASSWORD=change-me

# Adresse IP locale du serveur et port de l'interface SeedScope.
SEEDSCOPE_LAN_IP=192.168.1.10
SEEDSCOPE_PORT=3310

# Facultatif : regroupe plusieurs adresses d'un même tracker sous un seul nom.
SEEDSCOPE_TRACKER_ALIASES=announce.example.org=Exemple,tk.example.org=Exemple
